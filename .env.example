APP_ENV=development
LOG_LEVEL=INFO
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50051
PHOENIX_PORT=6006
# Copy the OAuth client JSON to this local-only directory; never commit it.
GMAIL_SECRETS_DIR=./secrets/gmail
# Stores the read-only OAuth token locally; keep it out of source control.
GMAIL_DATA_DIR=./data/gmail
