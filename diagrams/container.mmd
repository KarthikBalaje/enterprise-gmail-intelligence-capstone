flowchart TB
    User["Mailbox owner / reviewer"] --> UI["React frontend + Nginx"]
    UI --> API["FastAPI API gateway"]

    API --> Agent["Agent service"]
    API --> Gmail["Gmail API read-only"]

    Agent --> Guardrails["Guardrail policy engine"]
    Agent --> Rag["RAG service modules"]
    Rag --> Weaviate["Weaviate vector database"]
    Rag --> Ollama["Local Ollama models"]

    API -. OpenTelemetry .-> Phoenix["Arize Phoenix"]
    Agent -. OpenTelemetry .-> Phoenix

    CI["GitHub Actions CI"] -. validates .-> API
    CI -. validates .-> UI
