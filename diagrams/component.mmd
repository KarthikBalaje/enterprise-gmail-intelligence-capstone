flowchart TD
    Client["Client request"] --> Gateway["FastAPI gateway"]
    Gateway --> Cleanup["Cleanup plan endpoint"]
    Gateway --> RagAsk["RAG ask endpoint"]
    Gateway --> RagIndex["RAG index endpoint"]

    Cleanup --> Planner["Cleanup planner"]
    Planner --> Policy["Deterministic guardrail policy"]
    Policy --> Review["Dry-run review response"]

    RagIndex --> Ingestion["Email normalization and chunking"]
    Ingestion --> Embeddings["Ollama embeddings"]
    Embeddings --> Weaviate["Weaviate EmailChunk collection"]

    RagAsk --> Retrieval["Vector retrieval"]
    Retrieval --> Weaviate
    Retrieval --> Answer["Qwen grounded answer"]
    Answer --> Citations["Citation validator"]

    Gateway -. spans .-> Phoenix["Phoenix telemetry"]
    Planner -. spans .-> Phoenix
    Retrieval -. spans .-> Phoenix

    FutureWrites["Future write executor"]
    FutureWrites -. disabled / out of scope .-> Policy
